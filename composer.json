{
    "name": "saas-agent/agentstore",
    "description": "Connects a Laravel store to the SaaS Agent platform through a signed, capability-based contract.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SaasAgent\\AgentStore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SaasAgent\\AgentStore\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SaasAgent\\AgentStore\\AgentStoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
